   "source": [
    "def crop_price(price_list):\n",
    "    premium_crops = []\n",
    "    #Loop to filter prices\n",
    "    for price in price_list:\n",
    "        if price > 2000:\n",
    "            premium_crops.append(price)\n",
    "    print(\"Premium Crops:\", premium_crops)\n",
    "prices = [1500, 2500, 1800, 3200, 1900]\n",
    "crop_price(prices)"
   ],
