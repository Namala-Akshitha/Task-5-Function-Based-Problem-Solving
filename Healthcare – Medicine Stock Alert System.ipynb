   "source": [
    "def check_stock(stock):\n",
    "    print(\"Medicine Stock:\", stock)\n",
    "    if stock < 10:\n",
    "        print(\"Status: Low Stock Alert\")\n",
    "    else:\n",
    "        print(\"Status: Stock Sufficient\")\n",
    "stock_quantity = int(input(\"Enter medicine stock quantity: \"))\n",
    "check_stock(stock_quantity)"
   ],
